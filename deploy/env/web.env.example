# Run-time settings for the web app AND the worker on the Vultr server (both containers read this).
# Copy to deploy/env/web.env and fill in. deploy/env/ is gitignored; deploy.sh copies it to the
# server over SSH. Never commit the filled-in file. Placeholders only here.
#
# Set by docker-compose.yml from SITE_HOST, so leave them out of this file:
#   APP_BASE_URL (https://SITE_HOST) and NEXT_PUBLIC_GAME_SERVER_URL (wss://SITE_HOST/game, baked in
#   at build time).

# ── Database (Tiger Data Postgres; also the job queue) ────────────────
DATABASE_URL=
# Signs the anonymous learner cookie: openssl rand -hex 32
LEARNER_SECRET=
# Optional: keys the email-invite hash (otherwise derived from AUTH0_SECRET).
EMAIL_HASH_SECRET=

# ── Auth0 (docs/auth0.md) ─────────────────────────────────────────────
# In the Auth0 application add https://SITE_HOST/auth/callback to Allowed Callback URLs, and
# https://SITE_HOST to Allowed Logout URLs and Allowed Web Origins.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=

# ── Multiplayer ───────────────────────────────────────────────────────
# Must be the SAME value as GAME_TICKET_SECRET in game.env: openssl rand -hex 32
GAME_TICKET_SECRET=

# ── AI services ───────────────────────────────────────────────────────
GEMINI_API_KEY=
TINYFISH_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Vultr Object Storage (generated lessons + narration MP3s) ─────────
# From the Object Storage subscription's overview page in the Vultr dashboard (docs/vultr.md).
# Endpoint looks like https://ewr1.vultrobjects.com. The bucket stays private.
VULTR_OBJECT_STORAGE_ENDPOINT=
VULTR_OBJECT_STORAGE_BUCKET=
VULTR_OBJECT_STORAGE_ACCESS_KEY=
VULTR_OBJECT_STORAGE_SECRET_KEY=
# Optional (S3 signing region; Vultr accepts the default us-east-1).
VULTR_OBJECT_STORAGE_REGION=

# ── Worker (optional) ─────────────────────────────────────────────────
# Lesson jobs run at once by the worker container: 1 (default) or 2.
WORKER_CONCURRENCY=
