# Optional: the public host name for deploy.sh. Copy to deploy/env/site.env to keep it.
#
# Leave SITE_HOST empty (or skip this file) to use <server-ip-with-dashes>.sslip.io, a free name
# that resolves to the server's IP, e.g. 203-0-113-7.sslip.io. With your own domain, point an A
# record at the server first, then put the domain here (no https://).
SITE_HOST=
