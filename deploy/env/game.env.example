# Run-time settings for the game server (Colyseus) on the Vultr server.
# Copy to deploy/env/game.env and fill in. Never commit the filled-in file.
#
# Set by docker-compose.yml, so leave them out of this file:
#   GAME_SERVER_PORT (2567) and ALLOWED_ORIGINS (https://SITE_HOST).

# The SAME value as GAME_TICKET_SECRET in web.env (the web app signs join tickets with it).
GAME_TICKET_SECRET=
