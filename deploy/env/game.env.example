# Run-time settings for the game server (Colyseus) on the Vultr server.
# Copy to deploy/env/game.env and fill in. Never commit the filled-in file.
#
# Set by docker-compose.yml, so leave them out of this file:
#   GAME_SERVER_PORT (2567), ALLOWED_ORIGINS (https://SITE_HOST) and
#   WEB_INTERNAL_URL (http://web:3100: where the game server asks the web app for Ms. Fenwick's
#   chat replies; locally it defaults to http://localhost:3100).

# The SAME value as GAME_TICKET_SECRET in web.env (the web app signs join tickets with it, and
# checks the game server's signed requests for Ms. Fenwick's chat replies with it).
GAME_TICKET_SECRET=
