# syntax=docker/dockerfile:1.7
#
# OVR game server (apps/game-server, Colyseus) for the Vultr server. Built by
# deploy/docker-compose.yml with the repo root as context. tsup bundles @ovr/shared into dist/;
# the Colyseus packages stay in node_modules.

ARG NODE_VERSION=26

FROM node:${NODE_VERSION}-slim AS base
# The version in package.json "packageManager".
ARG PNPM_VERSION=12.21.0
ENV CI=true
RUN npm install -g pnpm@${PNPM_VERSION} && npm cache clean --force
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/game-server/package.json apps/game-server/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
RUN --mount=type=cache,id=ovr-pnpm-store,target=/pnpm-store \
    pnpm install --frozen-lockfile --store-dir /pnpm-store --filter "@ovr/game-server..."
COPY tsconfig.base.json ./
COPY packages packages
COPY apps/game-server apps/game-server
RUN pnpm --filter @ovr/game-server build

FROM build AS game
ENV NODE_ENV=production \
    GAME_SERVER_PORT=2567
USER node
WORKDIR /app/apps/game-server
EXPOSE 2567
CMD ["node", "dist/index.js"]
