{
  "name": "@ovr/web",
  "version": "0.0.0",
  "private": true,
  "description": "OVR website and 3D library client (Next.js + React Three Fiber).",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "pnpm assets && next dev --port 3000",
    "build": "pnpm assets && next build",
    "start": "next start --port 3000",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env.local --tsconfig tsconfig.json worker/index.ts",
    "dev:worker": "tsx watch --conditions=react-server --env-file-if-exists=.env.local --tsconfig tsconfig.json worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "node db/migrate.mjs",
    "db:seed-demo": "node db/seed-demo.mjs",
    "db:clear-demo": "node db/seed-demo.mjs --clear",
    "db:smoke": "node db/smoke.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.33.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@colyseus/sdk": "^0.18.10",
    "@google/genai": "3.4.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "@ovr/shared": "workspace:*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "hersheytext": "2.0.0",
    "next": "16.4.6",
    "perfect-freehand": "1.2.3",
    "postgres": "3.4.7",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "three": "^0.187.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "~5.1.0"
  }
}
