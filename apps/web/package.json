{
  "name": "@ovr/web",
  "version": "0.0.0",
  "private": true,
  "description": "OVR website and 3D library client (Next.js + React Three Fiber).",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "pnpm assets && next dev --port 3000",
    "build": "pnpm assets && next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@google/genai": "3.4.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "@ovr/shared": "workspace:*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "hersheytext": "2.0.0",
    "next": "16.4.6",
    "perfect-freehand": "1.2.3",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "~5.1.0"
  }
}
