# Copy to .env.local (web) / .env (game server) and fill in real values.
# Placeholders only — never commit real secrets.

# ── Game server (Phase 0+) ────────────────────────────────────────────
# Port the Colyseus server listens on locally.
GAME_SERVER_PORT=2567
# URL the browser uses to reach the game server.
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567

# ── Expression tracking (optional) ────────────────────────────────────
# Where the browser loads MediaPipe's face_landmarker.task model from. Leave empty to use the
# self-hosted copy in apps/web/public/models/; only set this to serve it from a CDN instead.
NEXT_PUBLIC_FACE_MODEL_URL=

# ── Supabase (added in a later phase: profiles, documents) ────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── LiveKit (Phase 4: proximity voice) ─────────────────────────────────
NEXT_PUBLIC_LIVEKIT_URL=
# Server-side only.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── AI whiteboard (Gemini) ─────────────────────────────────────────────
# Server-side only. Get a key at https://aistudio.google.com/apikey and put it in
# apps/web/.env.local. Reading/answering works on the free tier; writing the answer in the
# student's handwriting uses an image model that needs billing (~3–7¢ per answer). Without
# billing, answers are drawn in a handwriting font instead.
GEMINI_API_KEY=
# Optional overrides.
GEMINI_TEXT_MODEL=gemini-4-hydrogen
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Set to off to never call the image model (always use the handwriting font).
AI_HANDWRITING=on

# ── AI teacher (Phase 6) ──────────────────────────────────────────────
# Server-side only.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# AI Learning Studio narration uses ELEVENLABS_API_KEY above (optional: without it lessons use the
# browser's built-in voice).
# A voice id from your ElevenLabs voice library, and the TTS model.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=
# The AI Librarian's own voice (optional; defaults to "Lily"). Free ElevenLabs plans can only use
# premade voices via the API (e.g. Lily, Sarah, Matilda, Alice, George, Daniel), not library voices.
ELEVENLABS_LIBRARIAN_VOICE_ID=eleven_multilingual_v2

# ── Learning analytics (Tiger Data / TimescaleDB) ─────────────────────
# Server-side only. The service's connection URI (TIMESCALE_SERVICE_URL in the credentials file
# Tiger Cloud gives you). Then: pnpm --filter web db:migrate
DATABASE_URL=
# Signs the anonymous learner cookie. Any long random string: openssl rand -hex 32
LEARNER_SECRET=

# ── AI Librarian (TinyFish web research) ──────────────────────────────
# Server-side only. Create a key at https://agent.tinyfish.ai/api-keys (docs/ai-librarian.md).
TINYFISH_API_KEY=
# Optional: the Gemini model the Librarian uses (defaults to GEMINI_TEXT_FALLBACK_MODEL, fast).
GEMINI_LIBRARIAN_MODEL=
